// Place your key bindings in this file to override the defaults
[
  {
    "key": "f4",
    "command": "codeium.diffActionAccept",
    "when": "editorTextFocus && !inlineSuggestionsVisible"
  },
  {
    "key": "alt+a",
    "command": "-codeium.diffActionAccept",
    "when": "editorTextFocus && !inlineSuggestionsVisible"
  },
  {
    "key": "ctrl+shift+oem_period",
    "command": "-breadcrumbs.focusAndSelect",
    "when": "breadcrumbsPossible && breadcrumbsVisible"
  },
  {
    "key": "ctrl+shift+oem_1",
    "command": "-breadcrumbs.focus",
    "when": "breadcrumbsPossible && breadcrumbsVisible"
  },
  {
    "key": "ctrl+shift+oem_period",
    "command": "-breadcrumbs.toggleToOn",
    "when": "!config.breadcrumbs.enabled"
  },
  {
    "key": "ctrl+shift+i",
    "command": "-workbench.action.chat.openagent",
    "when": "config.chat.agent.enabled && !chatSetupDisabled && !chatSetupHidden"
  },
  {
    "key": "ctrl+shift+l",
    "command": "continue.focusContinueInput"
  },
  {
    "key": "ctrl+l",
    "command": "-continue.focusContinueInput"
  },
  {
    "key": "ctrl+shift+g g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active && !gitlens:disabled && config.gitlens.keymap == 'chorded'"
  },
  {
    "key": "ctrl+shift+i",
    "command": "cline.addToChat",
    "when": "editorHasSelection"
  },
  {
    "key": "ctrl+oem_7",
    "command": "-cline.addToChat",
    "when": "editorHasSelection"
  },
  {
    "key": "ctrl+shift+i",
    "command": "cline.focusChatInput",
    "when": "!editorHasSelection"
  },
  {
    "key": "ctrl+oem_7",
    "command": "-cline.focusChatInput",
    "when": "!editorHasSelection"
  },
  {
    "key": "ctrl+shift+i",
    "command": "-supermaven.addToChat"
  },
  {
    "key": "ctrl+shift+i",
    "command": "-workbench.action.chat.openagent",
    "when": "config.chat.agent.enabled && !chatSetupDisabledInWorkspace && !chatSetupHidden"
  },
  {
    "key": "ctrl+alt+l",
    "command": "workbench.action.increaseViewSize"
  },
  {
    "key": "ctrl+alt+h",
    "command": "workbench.action.decreaseViewSize"
  }
]