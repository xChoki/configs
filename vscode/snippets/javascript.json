	"darkmodebutton": {
		"prefix": "darkmodebutton",
		"body": [
			"const toggleTheme = () => {\r",
			"    const isDark = document.documentElement.classList.toggle(\"dark\")\r",
			"    localStorage.setItem(\"theme\", isDark ? \"dark\" : \"light\")\r",
			"\r",
			"    // Toggle between sun and moon icons visibility\r",
			"    const moonIcon = document.querySelector(\".moon\")\r",
			"    const sunIcon = document.querySelector(\".sun\")\r",
			"\r",
			"    if (moonIcon && sunIcon) {\r",
			"      if (isDark) {\r",
			"        sunIcon.style.display = \"none\"\r",
			"        moonIcon.style.display = \"inline\"\r",
			"      } else {\r",
			"        sunIcon.style.display = \"inline\"\r",
			"        moonIcon.style.display = \"none\"\r",
			"      }\r",
			"    }\r",
			"  }\r",
			"\r",
			"  // Check and apply stored theme\r",
			"  const storedTheme = localStorage.getItem(\"theme\")\r",
			"  if (storedTheme === \"dark\") {\r",
			"    document.documentElement.classList.add(\"dark\")\r",
			"  } else {\r",
			"    document.documentElement.classList.remove(\"dark\")\r",
			"  }\r",
			"\r",
			"  // Toggle between sun and moon icons visibility based on stored theme\r",
			"  const moonIcon = document.querySelector(\".moon\")\r",
			"  const sunIcon = document.querySelector(\".sun\")\r",
			"\r",
			"  if (moonIcon && sunIcon) {\r",
			"    if (storedTheme === \"dark\") {\r",
			"      sunIcon.style.display = \"none\"\r",
			"      moonIcon.style.display = \"inline\"\r",
			"    } else {\r",
			"      sunIcon.style.display = \"inline\"\r",
			"      moonIcon.style.display = \"none\"\r",
			"    }\r",
			"  }\r",
			"\r",
			"  document.getElementById(\"themeToggle\").addEventListener(\"click\", toggleTheme)"
		],
		"description": "description for darkmodebutton"
	}
}